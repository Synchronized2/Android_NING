<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true" android:drawable="@drawable/bg_mode_selected" />
    <item>
        <shape android:shape="rectangle">
            <gradient android:angle="315" android:startColor="#DD0A2B48" android:endColor="#DD051326" />
            <corners android:radius="6dp" />
            <stroke android:width="1dp" android:color="#008CFF" />
        </shape>
    </item>
</selector>
