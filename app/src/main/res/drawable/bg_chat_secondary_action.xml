<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="#DD0B4770" />
            <stroke android:width="1dp" android:color="#FF55F1FF" />
            <corners android:radius="7dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#E506203A" />
            <stroke android:width="1dp" android:color="#D20EA9DB" />
            <corners android:radius="7dp" />
        </shape>
    </item>
</selector>
