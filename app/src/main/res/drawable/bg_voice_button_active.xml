<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="oval">
            <solid android:color="#33FFB84D" />
            <stroke android:width="2dp" android:color="@color/warning" />
        </shape>
    </item>
    <item android:left="7dp" android:top="7dp" android:right="7dp" android:bottom="7dp">
        <shape android:shape="oval">
            <gradient
                android:angle="270"
                android:startColor="#89551A"
                android:endColor="#241608" />
            <stroke android:width="1dp" android:color="#FFFFD28C" />
        </shape>
    </item>
</layer-list>
