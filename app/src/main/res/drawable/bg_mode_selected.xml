<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient android:angle="270" android:startColor="#C8095680" android:endColor="#E6031D36" />
            <corners android:radius="4dp" />
            <stroke android:width="1dp" android:color="#00DFFF" />
        </shape>
    </item>
    <item android:gravity="bottom" android:height="2dp" android:left="20dp" android:right="20dp">
        <shape android:shape="rectangle"><solid android:color="#54F2FF" /></shape>
    </item>
</layer-list>
