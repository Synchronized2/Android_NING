<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_enabled="false">
        <shape android:shape="oval">
            <solid android:color="@color/surface_high" />
            <stroke android:width="2dp" android:color="@color/divider" />
        </shape>
    </item>
    <item android:state_pressed="true" android:drawable="@drawable/bg_voice_button_active" />
    <item>
        <layer-list>
            <item>
                <shape android:shape="oval">
                    <solid android:color="#330B81A8" />
                    <stroke android:width="2dp" android:color="@color/accent" />
                </shape>
            </item>
            <item android:left="7dp" android:top="7dp" android:right="7dp" android:bottom="7dp">
                <shape android:shape="oval">
                    <gradient
                        android:angle="270"
                        android:startColor="#143A6B"
                        android:endColor="#07192D" />
                    <stroke android:width="1dp" android:color="@color/cyber_blue" />
                </shape>
            </item>
        </layer-list>
    </item>
</selector>
