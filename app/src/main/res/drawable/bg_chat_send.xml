<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="#FF36D8F2" />
            <stroke android:width="2dp" android:color="#FFB6FAFF" />
            <corners android:radius="8dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient android:angle="90" android:startColor="#FF13C6ED" android:endColor="#FF087EC8" />
            <stroke android:width="1dp" android:color="#FF59F2FF" />
            <corners android:radius="8dp" />
        </shape>
    </item>
</selector>
