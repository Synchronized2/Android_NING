<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_chat_scene"
    android:fitsSystemWindows="true"
    android:orientation="vertical">

    <LinearLayout
        android:id="@+id/headerRow"
        android:layout_width="match_parent"
        android:layout_height="47dp"
        android:background="@drawable/bg_header_cyber"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="10dp"
        android:paddingEnd="8dp">

        <ImageView
            android:id="@+id/brandIcon"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:contentDescription="@null"
            android:importantForAccessibility="no"
            android:scaleType="fitCenter"
            android:src="@drawable/n_icon_transparent" />

        <LinearLayout
            android:id="@+id/titleSettingsButton"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="7dp"
            android:layout_weight="1"
            android:background="?android:attr/selectableItemBackground"
            android:clickable="true"
            android:contentDescription="@string/open_settings"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/brandWordmark"
                android:layout_width="47dp"
                android:layout_height="16dp"
                android:contentDescription="@string/app_name"
                android:scaleType="fitStart"
                android:src="@drawable/ning_wordmark_transparent" />

            <TextView
                android:id="@+id/activeModelText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/text_secondary"
                android:textSize="10sp" />
        </LinearLayout>

        <Button
            android:id="@+id/historyButton"
            android:layout_width="65dp"
            android:layout_height="22dp"
            android:background="@drawable/bg_header_history"
            android:backgroundTint="@null"
            android:drawableStart="@drawable/ic_history"
            android:drawablePadding="3dp"
            android:gravity="center"
            android:minWidth="0dp"
            android:paddingStart="5dp"
            android:paddingEnd="5dp"
            android:singleLine="true"
            android:stateListAnimator="@null"
            android:text="@string/conversation_history"
            android:textAllCaps="false"
            android:textColor="@color/accent"
            android:textSize="9sp" />

        <Button
            android:id="@+id/newConversationButton"
            android:layout_width="58dp"
            android:layout_height="22dp"
            android:layout_marginStart="4dp"
            android:background="@drawable/bg_header_new"
            android:backgroundTint="@null"
            android:drawableStart="@drawable/ic_add_circle"
            android:drawablePadding="3dp"
            android:gravity="center"
            android:minWidth="0dp"
            android:paddingStart="5dp"
            android:paddingEnd="5dp"
            android:singleLine="true"
            android:stateListAnimator="@null"
            android:text="@string/new_conversation"
            android:textAllCaps="false"
            android:textColor="@color/text_primary"
            android:textSize="9sp" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/divider" />

    <LinearLayout
        android:id="@+id/modeTabsRow"
        android:layout_width="match_parent"
        android:layout_height="28dp"
        android:background="@drawable/bg_header_cyber"
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingStart="8dp"
        android:paddingTop="3dp"
        android:paddingEnd="8dp"
        android:paddingBottom="3dp">

        <Button
            android:id="@+id/chatButton"
            android:layout_width="0dp"
            android:layout_height="22dp"
            android:layout_weight="1"
            android:background="@drawable/bg_tab_chat"
            android:backgroundTint="@null"
            android:gravity="center"
            android:minHeight="0dp"
            android:stateListAnimator="@null"
            android:text="@string/chat_action"
            android:textAllCaps="false"
            android:textColor="@color/text_primary"
            android:textSize="11sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/imageButton"
            android:layout_width="0dp"
            android:layout_height="22dp"
            android:layout_marginStart="-4dp"
            android:layout_weight="1"
            android:background="@drawable/bg_tab_image"
            android:backgroundTint="@null"
            android:gravity="center"
            android:minHeight="0dp"
            android:stateListAnimator="@null"
            android:text="@string/image_action"
            android:textAllCaps="false"
            android:textColor="@color/text_secondary"
            android:textSize="11sp"
            android:textStyle="bold" />
    </LinearLayout>

    <FrameLayout
        android:id="@+id/avatarStage"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="@color/avatar_stage">

        <ImageView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="@null"
            android:importantForAccessibility="no"
            android:scaleType="fitCenter"
            android:src="@drawable/ning_stage_background" />

        <cloud.pcie.openaiq.CyberEffectsView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:tag="stage"
            android:importantForAccessibility="no" />

        <cloud.pcie.openaiq.CyberEffectsView
            android:id="@+id/assistantPanelEffects"
            android:layout_width="110dp"
            android:layout_height="142dp"
            android:layout_gravity="top|start"
            android:layout_marginStart="26dp"
            android:layout_marginTop="58dp"
            android:importantForAccessibility="no"
            android:tag="assistantPanel" />

        <cloud.pcie.openaiq.Live2DAvatarView
            android:id="@+id/live2dAvatar"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="@string/live2d_avatar" />

        <TextView
            android:id="@+id/avatarStatusText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|start"
            android:layout_marginStart="14dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_status_pill"
            android:drawableStart="@drawable/ic_status_globe"
            android:drawablePadding="5dp"
            android:gravity="center_vertical"
            android:paddingStart="10dp"
            android:paddingTop="5dp"
            android:paddingEnd="10dp"
            android:paddingBottom="5dp"
            android:text="@string/avatar_loading"
            android:textColor="@color/text_primary"
            android:textSize="10sp" />

        <LinearLayout
            android:id="@+id/avatarDialog"
            android:layout_width="150dp"
            android:layout_height="wrap_content"
            android:layout_gravity="top|end"
            android:layout_marginTop="82dp"
            android:layout_marginEnd="12dp"
            android:background="@drawable/ning_avatar_dialog"
            android:orientation="vertical"
            android:paddingStart="13dp"
            android:paddingTop="11dp"
            android:paddingEnd="13dp"
            android:paddingBottom="25dp">

            <TextView
                android:id="@+id/avatarDialogRole"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/accent"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/avatarDialogText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:ellipsize="end"
                android:maxLines="3"
                android:textColor="@color/text_primary"
                android:textSize="13sp" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/viewToggleButton"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_gravity="bottom|end"
            android:layout_marginEnd="22dp"
            android:layout_marginBottom="156dp"
            android:background="@drawable/bg_view_toggle"
            android:contentDescription="@string/switch_to_full_body"
            android:padding="8dp"
            android:src="@drawable/ic_avatar_full"
            android:tint="@color/accent" />

        <FrameLayout
            android:id="@+id/voiceControls"
            android:layout_width="match_parent"
            android:layout_height="128dp"
            android:layout_gravity="bottom"
            android:clipChildren="false">

            <ImageView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="@null"
                android:importantForAccessibility="no"
                android:scaleType="fitXY"
                android:src="@drawable/ning_voice_dock_background" />

            <TextView
                android:id="@+id/voiceStatusText"
                android:layout_width="match_parent"
                android:layout_height="18dp"
                android:layout_gravity="top"
                android:layout_marginTop="9dp"
                android:gravity="center"
                android:maxLines="1"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:text="@string/tap_to_talk"
                android:textColor="@color/text_primary"
                android:textSize="10sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="92dp"
                android:layout_gravity="top"
                android:layout_marginTop="18dp"
                android:baselineAligned="false"
                android:clipChildren="false"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <Space
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="3" />

                <FrameLayout
                    android:layout_width="48dp"
                    android:layout_height="match_parent">

                    <ImageButton
                        android:id="@+id/keyboardButton"
                        android:layout_width="42dp"
                        android:layout_height="42dp"
                        android:layout_gravity="center"
                        android:background="@drawable/bg_voice_side_hud"
                        android:contentDescription="@string/use_keyboard"
                        android:padding="14dp"
                        android:src="@drawable/ic_keyboard"
                        android:tint="@color/text_primary" />
                </FrameLayout>

                <Space
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1" />

                <FrameLayout
                    android:layout_width="124dp"
                    android:layout_height="92dp"
                    android:clipChildren="false">

                    <cloud.pcie.openaiq.CyberEffectsView
                        android:id="@+id/micEffects"
                        android:layout_width="160dp"
                        android:layout_height="92dp"
                        android:layout_gravity="center"
                        android:tag="mic"
                        android:importantForAccessibility="no" />

                    <ImageButton
                        android:id="@+id/voiceButton"
                        android:layout_width="56dp"
                        android:layout_height="56dp"
                        android:layout_gravity="center"
                        android:background="@drawable/bg_voice_mic_core"
                        android:contentDescription="@string/start_voice_chat"
                        android:padding="13dp"
                        android:src="@drawable/ic_mic"
                        android:tint="@color/text_primary" />
                </FrameLayout>

                <Space
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1" />

                <FrameLayout
                    android:layout_width="48dp"
                    android:layout_height="match_parent">

                    <ImageButton
                        android:id="@+id/audioActionButton"
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:layout_gravity="center"
                        android:background="@drawable/bg_voice_side_hud"
                        android:contentDescription="@string/read_latest_reply"
                        android:padding="14dp"
                        android:src="@drawable/ic_sound_on"
                        android:tint="@color/accent" />
                </FrameLayout>

                <Space
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="3" />
            </LinearLayout>
        </FrameLayout>
    </FrameLayout>

    <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/divider" />

    <ListView
        android:id="@+id/messageList"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:background="#26000612"
        android:divider="@android:color/transparent"
        android:dividerHeight="0dp"
        android:listSelector="@android:color/transparent"
        android:paddingTop="4dp"
        android:paddingBottom="4dp"
        android:stackFromBottom="false"
        android:transcriptMode="normal" />

    <TextView
        android:id="@+id/statusText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="18dp"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        android:textColor="@color/text_secondary"
        android:textSize="10sp"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/attachmentBar"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        android:visibility="gone">

        <ImageView
            android:id="@+id/attachmentPreview"
                        android:layout_width="36dp"
                        android:layout_height="36dp"
            android:contentDescription="@string/image"
            android:scaleType="centerCrop" />

        <TextView
            android:id="@+id/attachmentText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:ellipsize="middle"
            android:maxLines="1"
            android:textColor="@color/text_secondary"
            android:textSize="12sp" />

        <Button
            android:id="@+id/removeAttachmentButton"
            android:layout_width="52dp"
            android:layout_height="36dp"
            android:backgroundTint="@color/surface_high"
            android:minWidth="0dp"
            android:text="@string/remove"
            android:textAllCaps="false"
            android:textColor="@color/warning" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/composerRow"
        android:baselineAligned="false"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_chat_composer"
        android:gravity="bottom"
        android:orientation="horizontal"
        android:paddingStart="8dp"
        android:paddingTop="5dp"
        android:paddingEnd="8dp"
        android:paddingBottom="5dp">

        <ImageButton
            android:id="@+id/attachmentButton"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:background="@drawable/bg_chat_secondary_action"
            android:backgroundTint="@null"
            android:contentDescription="@string/add_reference_image"
            android:minWidth="0dp"
            android:padding="0dp"
            android:src="@drawable/ic_add_reference"
            android:scaleType="fitCenter"
            android:tint="@color/accent" />

        <ImageButton
            android:id="@+id/voiceModeButton"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:background="@drawable/bg_chat_secondary_action"
            android:backgroundTint="@null"
            android:contentDescription="@string/return_to_voice"
            android:padding="6dp"
            android:src="@drawable/ic_mic"
            android:tint="@color/accent"
            android:visibility="gone" />

        <EditText
            android:id="@+id/messageInput"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:layout_weight="1"
            android:background="@drawable/bg_chat_input"
            android:gravity="center_vertical|start"
            android:includeFontPadding="false"
            android:hint="@string/message_hint"
            android:importantForAutofill="no"
            android:inputType="textCapSentences|textMultiLine"
            android:maxLines="4"
            android:minHeight="24dp"
            android:textSize="11sp"
            android:textColor="@color/text_primary"
            android:textColorHint="@color/text_secondary" />

        <ImageButton
            android:id="@+id/sendButton"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginStart="4dp"
            android:background="@drawable/bg_chat_send"
            android:backgroundTint="@null"
            android:contentDescription="@string/send"
            android:src="@drawable/ic_send"
            android:scaleType="fitCenter"
            android:tint="@color/accent"
            android:minWidth="0dp"
            android:padding="6dp"
            android:focusable="true" />
    </LinearLayout>
</LinearLayout>
